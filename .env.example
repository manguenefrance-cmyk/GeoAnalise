# Test mode is deliberately explicit; NEVER set it on an internet-facing deployment.
APP_ENV=test
DATABASE_URL=sqlite:///./data/arcambe.db
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_PROJECT_ID=arcambe-geoanalytics
GOOGLE_APPLICATION_CREDENTIALS=
STAC_URL=https://stac.dataspace.copernicus.eu/v1
STAC_COLLECTION=sentinel-2-l2a
RASTER_ALLOWED_HOSTS=sentinel-cogs.s3.us-west-2.amazonaws.com,e84-earth-search-sentinel-data.s3.us-west-2.amazonaws.com,landsateuwest.blob.core.windows.net
DAILY_JOB_LIMIT=5
DAILY_ATTEMPT_LIMIT=20
CONCURRENT_JOB_LIMIT=1
MAX_AOI_KM2=100
MAX_PIXELS=2000000
DOWNLOAD_SECRET=replace-with-at-least-32-random-characters
# New artifacts: local files or private GCS. Old local artifacts retain their existing keys.
STORAGE_BACKEND=local
GCS_BUCKET=
# Optional IAM signBlob signer for workload identity credentials; no private key required.
GCS_SIGNER_EMAIL=
MAX_ARTIFACT_BYTES=150000000

