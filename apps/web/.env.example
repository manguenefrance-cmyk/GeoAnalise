# The registered public ARCAMBE profile is bundled in lib/firebase-public.json.
# Optional overrides: supply API_KEY, AUTH_DOMAIN and PROJECT_ID together.
# Public Firebase configuration is not an administrator credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
